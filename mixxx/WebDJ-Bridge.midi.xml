      <group>[EqualizerRack1_[Channel1]_Effect1]</group>
      <key>parameter3</key>
      <status>0xB0</status>
      <midino>0x04</midino>
      <options><Normal/></options>
    </control>
    <control>
      <description>Deck A EQ mid</description>
      <group>[EqualizerRack1_[Channel1]_Effect1]</group>
      <key>parameter2</key>
      <status>0xB0</status>
      <midino>0x06</midino>
      <options><Normal/></options>
    </control>
    <control>
      <description>Deck A EQ low</description>
      <group>[EqualizerRack1_[Channel1]_Effect1]</group>
      <key>parameter1</key>
      <status>0xB0</status>
      <midino>0x08</midino>
      <options><Normal/></options>
    </control>
    <control>
