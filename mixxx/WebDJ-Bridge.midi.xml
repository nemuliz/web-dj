      <group>[Channel2]</group>
      <key>WebDJBridge.pitchReset</key>
      <status>0x90</status>
      <midino>0x2d</midino>
      <options><Script-Binding/></options>
    </control>
    <control>
      <description>Deck B headphone cue</description>
      <group>[Channel2]</group>
      <key>pfl</key>
      <status>0x90</status>
      <midino>0x2f</midino>
      <options><Normal/></options>
    </control>
    <control>
      <description>Deck B HOT CUE 1</description>
      <group>[Channel2]</group>
      <key>WebDJBridge.hotcue1</key>
      <status>0x90</status>
      <midino>0x34</midino>
      <options><Script-Binding/></options>
    </control>
    <control>
      <description>Deck B HOT CUE 2</description>
      <group>[Channel2]</group>
      <key>WebDJBridge.hotcue2</key>
      <status>0x90</status>
      <midino>0x35</midino>
      <options><Script-Binding/></options>
    </control>
    <control>
      <description>Deck B HOT CUE 3</description>
      <group>[Channel2]</group>
      <key>WebDJBridge.hotcue3</key>
      <status>0x90</status>
      <midino>0x36</midino>
      <options><Script-Binding/></options>
    </control>
    <control>
      <description>Deck B HOT CUE 4</description>
      <group>[Channel2]</group>
      <key>WebDJBridge.hotcue4</key>
      <status>0x90</status>
      <midino>0x37</midino>
      <options><Script-Binding/></options>
    </control>
    <control>
      <description>Deck B LOOP IN</description>
      <group>[Channel2]</group>
      <key>loop_in</key>
      <status>0x90</status>
      <midino>0x3b</midino>
      <options><Normal/></options>
    </control>
    <control>
      <description>Deck B LOOP OUT</description>
      <group>[Channel2]</group>
      <key>loop_out</key>
      <status>0x90</status>
      <midino>0x3d</midino>
      <options><Normal/></options>
    </control>
    <control>
      <description>Deck B RELOOP / EXIT</description>
      <group>[Channel2]</group>
      <key>reloop_toggle</key>
      <status>0x90</status>
      <midino>0x3f</midino>
      <options><Normal/></options>
    </control>
    <control>
      <description>Deck B jog touch</description>
      <group>[Channel2]</group>
      <key>WebDJBridge.jogTouch</key>
      <status>0x90</status>
      <midino>0x41</midino>
      <options><Script-Binding/></options>
    </control>
    <control>
      <description>Deck B jog touch release</description>
      <group>[Channel2]</group>
      <key>WebDJBridge.jogTouch</key>
      <status>0x80</status>
      <midino>0x41</midino>
      <options><Script-Binding/></options>
    </control>
    <control>
      <description>Deck B jog turn</description>
      <group>[Channel2]</group>
      <key>WebDJBridge.jogTurn</key>
      <status>0xB0</status>
      <midino>0x15</midino>
      <options><Script-Binding/></options>
    </control>
    <control>
      <description>Deck B pitch</description>
      <group>[Channel2]</group>
      <key>WebDJBridge.pitchRate</key>
      <status>0xB0</status>
      <midino>0x01</midino>
      <options><Script-Binding/></options>
    </control>
    <control>
      <description>Deck B trim</description>
      <group>[Channel2]</group>
      <key>WebDJBridge.trim</key>
      <status>0xB0</status>
      <midino>0x03</midino>
      <options><Script-Binding/></options>
    </control>
    <control>
      <description>Deck B EQ high</description>
      <group>[EqualizerRack1_[Channel2]_Effect1]</group>
      <key>parameter3</key>
      <status>0xB0</status>
      <midino>0x05</midino>
      <options><Normal/></options>
    </control>
    <control>
      <description>Deck B EQ mid</description>
      <group>[EqualizerRack1_[Channel2]_Effect1]</group>
      <key>parameter2</key>
      <status>0xB0</status>
      <midino>0x07</midino>
      <options><Normal/></options>
    </control>
    <control>
      <description>Deck B EQ low</description>
      <group>[EqualizerRack1_[Channel2]_Effect1]</group>
      <key>parameter1</key>
      <status>0xB0</status>
      <midino>0x09</midino>
      <options><Normal/></options>
    </control>
    <control>
      <description>Deck B filter</description>
      <group>[QuickEffectRack1_[Channel2]]</group>
      <key>super1</key>
      <status>0xB0</status>
      <midino>0x0b</midino>
      <options><Normal/></options>
    </control>
    <control>
      <description>Deck B channel fader</description>
      <group>[Channel2]</group>
      <key>volume</key>
      <status>0xB0</status>
      <midino>0x0d</midino>
      <options><Normal/></options>
    </control>
    <control>
      <description>Master gain</description>
      <group>[Master]</group>
      <key>WebDJBridge.masterGain</key>
      <status>0xB0</status>
      <midino>0x0e</midino>
      <options><Script-Binding/></options>
    </control>
    <control>
      <description>Crossfader</description>
      <group>[Master]</group>
      <key>crossfader</key>
      <status>0xB0</status>
      <midino>0x0f</midino>
      <options><Normal/></options>
    </control>
    <control>
      <description>Headphone mix</description>
      <group>[Master]</group>
      <key>WebDJBridge.headMix</key>
      <status>0xB0</status>
      <midino>0x10</midino>
      <options><Script-Binding/></options>
    </control>
      <control><description>Deck A CUE release</description><group>[Channel1]</group><key>WebDJBridge.cue</key><status>0x80</status><midino>0x26</midino><options><Script-Binding/></options></control>
      <control><description>Deck A HOT CUE 1 release</description><group>[Channel1]</group><key>WebDJBridge.hotcue1</key><status>0x80</status><midino>0x30</midino><options><Script-Binding/></options></control>
      <control><description>Deck A HOT CUE 2 release</description><group>[Channel1]</group><key>WebDJBridge.hotcue2</key><status>0x80</status><midino>0x31</midino><options><Script-Binding/></options></control>
      <control><description>Deck A HOT CUE 3 release</description><group>[Channel1]</group><key>WebDJBridge.hotcue3</key><status>0x80</status><midino>0x32</midino><options><Script-Binding/></options></control>
      <control><description>Deck A HOT CUE 4 release</description><group>[Channel1]</group><key>WebDJBridge.hotcue4</key><status>0x80</status><midino>0x33</midino><options><Script-Binding/></options></control>
      <control><description>Deck B CUE release</description><group>[Channel2]</group><key>WebDJBridge.cue</key><status>0x80</status><midino>0x27</midino><options><Script-Binding/></options></control>
      <control><description>Deck B HOT CUE 1 release</description><group>[Channel2]</group><key>WebDJBridge.hotcue1</key><status>0x80</status><midino>0x34</midino><options><Script-Binding/></options></control>
      <control><description>Deck B HOT CUE 2 release</description><group>[Channel2]</group><key>WebDJBridge.hotcue2</key><status>0x80</status><midino>0x35</midino><options><Script-Binding/></options></control>
      <control><description>Deck B HOT CUE 3 release</description><group>[Channel2]</group><key>WebDJBridge.hotcue3</key><status>0x80</status><midino>0x36</midino><options><Script-Binding/></options></control>
      <control><description>Deck B HOT CUE 4 release</description><group>[Channel2]</group><key>WebDJBridge.hotcue4</key><status>0x80</status><midino>0x37</midino><options><Script-Binding/></options></control>
    </controls>
    <outputs>
      <!-- Feedback notes are intentionally distinct from input notes 0x24-0x3F,
           preventing loopMIDI echo from being mistaken for actual Mixxx state. -->
      <output><description>Deck A play state feedback</description><group>[Channel1]</group><key>play_indicator</key><status>0x90</status><midino>0x50</midino><on>0x7F</on><off>0x00</off></output>
      <output><description>Deck B play state feedback</description><group>[Channel2]</group><key>play_indicator</key><status>0x90</status><midino>0x51</midino><on>0x7F</on><off>0x00</off></output>
      <output><description>Deck A cue indicator feedback</description><group>[Channel1]</group><key>cue_indicator</key><status>0x90</status><midino>0x52</midino><on>0x7F</on><off>0x00</off></output>
      <output><description>Deck B cue indicator feedback</description><group>[Channel2]</group><key>cue_indicator</key><status>0x90</status><midino>0x53</midino><on>0x7F</on><off>0x00</off></output>
