      <group>[QuickEffectRack1_[Channel1]]</group>
      <key>super1</key>
      <status>0xB0</status>
      <midino>0x0a</midino>
      <options><Normal/></options>
    </control>
    <control>
      <description>Deck A channel fader</description>
      <group>[Channel1]</group>
      <key>volume</key>
      <status>0xB0</status>
      <midino>0x0c</midino>
      <options><Normal/></options>
    </control>
    <control>
      <description>Deck B PLAY / PAUSE</description>
      <group>[Channel2]</group>
      <key>play</key>
      <status>0x90</status>
      <midino>0x25</midino>
      <options><Normal/></options>
    </control>
    <control>
      <description>Deck B CUE</description>
      <group>[Channel2]</group>
      <key>WebDJBridge.cue</key>
      <status>0x90</status>
      <midino>0x27</midino>
      <options><Script-Binding/></options>
    </control>
    <control>
      <description>Deck B SYNC</description>
      <group>[Channel2]</group>
      <key>WebDJBridge.sync</key>
