<?xml version="1.0" encoding="UTF-8"?>
<MixxxControllerPreset schemaVersion="1" mixxxVersion="2.6">
  <info>
    <name>WebDJ Bridge (FLX4-style)</name>
    <author>WebDJ project</author>
    <description>Two-deck WebDJ mapping inspired by the Mixxx Pioneer DDJ-FLX4 workflow. Uses generic MIDI from WebDJ over loopMIDI; it does not impersonate Pioneer hardware.</description>
  </info>
  <controller id="WebDJ Bridge">
    <scriptfiles>
      <file functionprefix="WebDJBridge" filename="WebDJ-Bridge-script.js"/>
    </scriptfiles>
    <controls>
    <control>
      <description>Deck A PLAY / PAUSE</description>
      <group>[Channel1]</group>
      <key>play</key>
      <status>0x90</status>
      <midino>0x24</midino>
      <options><Normal/></options>
    </control>
    <control>
      <description>Deck A CUE</description>
      <group>[Channel1]</group>
      <key>WebDJBridge.cue</key>
      <status>0x90</status>
      <midino>0x26</midino>
      <options><Script-Binding/></options>
    </control>
    <control>
      <description>Deck A SYNC</description>
      <group>[Channel1]</group>
      <key>WebDJBridge.sync</key>
      <status>0x90</status>
      <midino>0x28</midino>
      <options><Script-Binding/></options>
    </control>
    <control>
      <description>Deck A 2 beat loop toggle</description>
      <group>[Channel1]</group>
      <key>beatloop_2_toggle</key>
      <status>0x90</status>
      <midino>0x2a</midino>
      <options><Normal/></options>
    </control>
    <control>
      <description>Deck A pitch reset</description>
      <group>[Channel1]</group>
      <key>WebDJBridge.pitchReset</key>
      <status>0x90</status>
      <midino>0x2c</midino>
      <options><Script-Binding/></options>
    </control>
    <control>
      <description>Deck A headphone cue</description>
      <group>[Channel1]</group>
      <key>pfl</key>
      <status>0x90</status>
      <midino>0x2e</midino>
      <options><Normal/></options>
    </control>
    <control>
      <description>Deck A HOT CUE 1</description>
      <group>[Channel1]</group>
      <key>WebDJBridge.hotcue1</key>
      <status>0x90</status>
      <midino>0x30</midino>
      <options><Script-Binding/></options>
    </control>
    <control>
      <description>Deck A HOT CUE 2</description>
      <group>[Channel1]</group>
      <key>WebDJBridge.hotcue2</key>
      <status>0x90</status>
      <midino>0x31</midino>
      <options><Script-Binding/></options>
    </control>
    <control>
      <description>Deck A HOT CUE 3</description>
      <group>[Channel1]</group>
      <key>WebDJBridge.hotcue3</key>
      <status>0x90</status>
      <midino>0x32</midino>
      <options><Script-Binding/></options>
    </control>
    <control>
      <description>Deck A HOT CUE 4</description>
      <group>[Channel1]</group>
      <key>WebDJBridge.hotcue4</key>
      <status>0x90</status>
      <midino>0x33</midino>
      <options><Script-Binding/></options>
    </control>
    <control>
      <description>Deck A LOOP IN</description>
      <group>[Channel1]</group>
      <key>loop_in</key>
      <status>0x90</status>
      <midino>0x3a</midino>
      <options><Normal/></options>
    </control>
    <control>
      <description>Deck A LOOP OUT</description>
      <group>[Channel1]</group>
      <key>loop_out</key>
      <status>0x90</status>
      <midino>0x3c</midino>
      <options><Normal/></options>
    </control>
    <control>
      <description>Deck A RELOOP / EXIT</description>
      <group>[Channel1]</group>
      <key>reloop_toggle</key>
      <status>0x90</status>
      <midino>0x3e</midino>
      <options><Normal/></options>
    </control>
    <control>
