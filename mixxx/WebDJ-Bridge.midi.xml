      <status>0x80</status>
      <midino>0x40</midino>
      <options><Script-Binding/></options>
    </control>
    <control>
      <description>Deck A jog turn</description>
      <group>[Channel1]</group>
      <key>WebDJBridge.jogTurn</key>
      <status>0xB0</status>
      <midino>0x14</midino>
      <options><Script-Binding/></options>
    </control>
    <control>
      <description>Deck A pitch</description>
      <group>[Channel1]</group>
      <key>WebDJBridge.pitchRate</key>
      <status>0xB0</status>
      <midino>0x00</midino>
