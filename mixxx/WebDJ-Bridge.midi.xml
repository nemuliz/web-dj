      <output><description>Deck B sync state feedback</description><group>[Channel2]</group><key>sync_enabled</key><status>0x90</status><midino>0x55</midino><on>0x7F</on><off>0x00</off></output>
      <output><description>Deck A HOT CUE 1 assigned state feedback</description><group>[Channel1]</group><key>hotcue_1_enabled</key><status>0x90</status><midino>0x58</midino><on>0x7F</on><off>0x00</off></output>
      <output><description>Deck A HOT CUE 2 assigned state feedback</description><group>[Channel1]</group><key>hotcue_2_enabled</key><status>0x90</status><midino>0x59</midino><on>0x7F</on><off>0x00</off></output>
      <output><description>Deck A HOT CUE 3 assigned state feedback</description><group>[Channel1]</group><key>hotcue_3_enabled</key><status>0x90</status><midino>0x5A</midino><on>0x7F</on><off>0x00</off></output>
      <output><description>Deck A HOT CUE 4 assigned state feedback</description><group>[Channel1]</group><key>hotcue_4_enabled</key><status>0x90</status><midino>0x5B</midino><on>0x7F</on><off>0x00</off></output>
      <output><description>Deck B HOT CUE 1 assigned state feedback</description><group>[Channel2]</group><key>hotcue_1_enabled</key><status>0x90</status><midino>0x5C</midino><on>0x7F</on><off>0x00</off></output>
      <output><description>Deck B HOT CUE 2 assigned state feedback</description><group>[Channel2]</group><key>hotcue_2_enabled</key><status>0x90</status><midino>0x5D</midino><on>0x7F</on><off>0x00</off></output>
      <output><description>Deck B HOT CUE 3 assigned state feedback</description><group>[Channel2]</group><key>hotcue_3_enabled</key><status>0x90</status><midino>0x5E</midino><on>0x7F</on><off>0x00</off></output>
      <output><description>Deck B HOT CUE 4 assigned state feedback</description><group>[Channel2]</group><key>hotcue_4_enabled</key><status>0x90</status><midino>0x5F</midino><on>0x7F</on><off>0x00</off></output>
